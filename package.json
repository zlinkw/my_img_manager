{
  "name": "zotero-pdf-image-saver",
  "version": "0.1.151",
  "private": true,
  "description": "Zotero 论文图片框选、外部 SQLite 原图库与共享图库界面。",
  "scripts": {
    "test": "node tests/current-release.test.js",
    "audit:index-buttons": "node scripts/audit-index-buttons.mjs",
    "check": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/check-current-release.ps1",
    "build": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/build.ps1",
    "fetch:runtime": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/fetch-runtime.ps1",
    "prepackage:manual": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/fetch-runtime.ps1",
    "package:manual": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/package-manual.ps1",
    "verify:manual": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/verify-manual-install.ps1",
    "install:global": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/install-global.ps1",
    "install:xpi": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/install-global.ps1 -InstallMode XPI",
    "runtime:status": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/runtime-status.ps1",
    "smoke:preflight": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/smoke-preflight.ps1",
    "smoke:wait": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/smoke-wait.ps1",
    "smoke:close": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/smoke-one-close.ps1",
    "smoke:close:isolated": "pwsh.exe -ExecutionPolicy Bypass -NoProfile -File scripts/smoke-isolated-close.ps1",
    "audit:viewer": "node scripts/audit-viewer-engine.mjs"
  }
}
